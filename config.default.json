{
  "device_name": "FeedNode",
  "subtitle": "Unified Chat Feed",
  "layout": {
    "orientation": "portrait",
    "mode": "combined",
    "order": "activity-first",
    "split_ratio": 35,
    "newest": "bottom"
  },
  "style": {
    "font_family": "Inter",
    "font_url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
    "background": "#080A0D",
    "panel": "#10141A",
    "event_panel": "#14101A",
    "system_event_panel": "#17131F",
    "system_event_accent": "#8C5CFF",
    "twitch_event_panel": "#181225",
    "twitch_event_accent": "#9147FF",
    "rumble_event_panel": "#102019",
    "rumble_event_accent": "#85C742",
    "youtube_event_panel": "#241313",
    "youtube_event_accent": "#FF4E45",
    "kick_event_panel": "#102116",
    "kick_event_accent": "#53FC18",
    "text": "#F4F7FA",
    "muted": "#8C98A6",
    "accent": "#39E6D0",
    "activity_accent": "#8C5CFF",
    "message_size": 24,
    "username_size": 21,
    "event_size": 20,
    "avatar_size": 42,
    "gif_size": 72,
    "radius": 10,
    "spacing": 12,
    "show_platform": true,
    "show_avatars": true,
    "show_badges": true,
    "use_platform_colors": true,
    "show_timestamps": false,
    "animated_emotes": true,
    "max_animated_emotes": 12,
    "show_stats_bar": false,
    "stats_mode": "combined",
    "combined_stats_viewers": true,
    "combined_stats_followers": true,
    "combined_stats_subscribers": true,
    "combined_stats_likes": false,
    "twitch_stats_viewers": true,
    "twitch_stats_followers": true,
    "twitch_stats_subscribers": true,
    "rumble_stats_viewers": true,
    "rumble_stats_followers": true,
    "rumble_stats_subscribers": true,
    "rumble_stats_likes": true,
    "youtube_stats_viewers": true,
    "youtube_stats_subscribers": true,
    "youtube_stats_members": true,
    "youtube_stats_likes": true,
    "kick_stats_viewers": true,
    "kick_stats_followers": true,
    "kick_stats_subscribers": true,
    "kick_stats_likes": true,
    "show_build_footer": false,
    "stats_bar_panel": "#10141A",
    "stats_title_size": 14,
    "stats_number_size": 20,
    "stats_color": "#8C98A6",
    "stats_accent": "#F4F7FA"
  },
  "system": {
    "max_feed_items": 100,
    "update_feed": "stable"
  },
  "platforms": {
    "twitch": {"enabled": true},
    "youtube": {"enabled": false},
    "rumble": {"enabled": false},
    "kick": {"enabled": false}
  }
}
