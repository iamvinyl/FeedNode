[Unit]
Description=FeedNode HDMI Kiosk
After=feednode.service network-online.target
Requires=feednode.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=feednode
Group=feednode
Environment=HOME=/home/feednode
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/feednode/.Xauthority
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/startx /usr/local/bin/feednode-kiosk -- :0 vt1 -nolisten tcp
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
