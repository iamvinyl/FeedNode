[Unit]
Description=FeedNode Native HDMI Display (SDL2/KMSDRM)
After=feednode.service systemd-user-sessions.service feednode-splash.service
Requires=feednode.service
Conflicts=getty@tty1.service feednode-splash.service

[Service]
Type=simple
User=feednode
Group=feednode
SupplementaryGroups=video render input
Environment=HOME=/home/feednode
Environment=FEEDNODE_STATE=/var/lib/feednode
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
PAMName=login
ExecStart=/opt/feednode/venv/bin/python /opt/feednode/current/platform_display.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
