[Unit]
Description=FeedNode Unified Chat Feed
After=NetworkManager.service

[Service]
Type=simple
User=feednode
Group=feednode
WorkingDirectory=/opt/feednode/current
EnvironmentFile=-/etc/feednode/feednode.env
Environment=FEEDNODE_STATE=/var/lib/feednode
ExecStart=/opt/feednode/venv/bin/uvicorn app_wrapper:app --host 0.0.0.0 --port 8787
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
