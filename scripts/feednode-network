#!/bin/bash
set -euo pipefail
ACTION=${1:-}
AP_NAME="FeedNode-Setup"
AP_CON="feednode-setup"
WLAN="wlan0"

ensure_wifi_ready() {
  nmcli radio wifi on >/dev/null 2>&1 || true
  nmcli device set "$WLAN" managed yes >/dev/null 2>&1 || true
  ip link set "$WLAN" up >/dev/null 2>&1 || true
}

start_ap() {
  ensure_wifi_ready
  nmcli con down "$AP_CON" >/dev/null 2>&1 || true
  nmcli con delete "$AP_CON" >/dev/null 2>&1 || true
  nmcli con add type wifi ifname "$WLAN" con-name "$AP_CON" autoconnect yes ssid "$AP_NAME"
  nmcli con modify "$AP_CON" \
    802-11-wireless.mode ap \
    802-11-wireless.band bg \
    ipv4.method shared \
    ipv6.method disabled \
    connection.autoconnect yes \
    connection.autoconnect-priority 100
  nmcli con up "$AP_CON"
}

stop_ap_for_client() {
  nmcli con down "$AP_CON" >/dev/null 2>&1 || true
  nmcli con delete "$AP_CON" >/dev/null 2>&1 || true
  ensure_wifi_ready
  nmcli device disconnect "$WLAN" >/dev/null 2>&1 || true
  sleep 1
  nmcli device set "$WLAN" managed yes >/dev/null 2>&1 || true
  nmcli radio wifi on >/dev/null 2>&1 || true
  nmcli device wifi rescan ifname "$WLAN" >/dev/null 2>&1 || true
  sleep 2
}

ap_active() {
  [ "$(nmcli -g GENERAL.CONNECTION device show "$WLAN" 2>/dev/null || true)" = "$AP_CON" ]
}

case "$ACTION" in
  ap)
    if ! start_ap || ! ap_active; then
      systemctl restart NetworkManager
      sleep 3
      start_ap
    fi
    ap_active || { echo "Unable to start $AP_NAME on $WLAN" >&2; exit 1; }
    ;;
  connect)
    SSID=${2:?SSID required}; PASS=${3:-}
    stop_ap_for_client
    if [ -n "$PASS" ]; then
      if ! nmcli dev wifi connect "$SSID" password "$PASS" ifname "$WLAN"; then
        echo "Unable to connect to $SSID; restoring $AP_NAME" >&2
        start_ap || true
        exit 1
      fi
    else
      if ! nmcli dev wifi connect "$SSID" ifname "$WLAN"; then
        echo "Unable to connect to $SSID; restoring $AP_NAME" >&2
        start_ap || true
        exit 1
      fi
    fi
    ;;
  clear)
    ensure_wifi_ready
    # Remove every saved Wi-Fi profile. The setup AP is recreated from scratch
    # below so factory reset cannot inherit a stale/broken AP profile.
    while IFS=: read -r name type; do
      if [ "$type" = "802-11-wireless" ]; then
        nmcli con delete "$name" >/dev/null 2>&1 || true
      fi
    done < <(nmcli -t -f NAME,TYPE con show)
    "$0" ap
    ;;
  *) echo "usage: feednode-network {ap|connect <ssid> [password]|clear}" >&2; exit 2;;
esac
